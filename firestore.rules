rules_version='2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function resourceOwner() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    match /reflections/{reflectionId} {
      allow read: if signedIn() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.visibility == "shared_with_teacher");

      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;

      allow update, delete: if resourceOwner() ||
        (signedIn() && resource.data.visibility == "shared_with_teacher");
    }

    match /portfolios/{portfolioId} {
      allow read: if resourceOwner();
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;

      allow update, delete: if resourceOwner();
    }

    match /slidesIntegrations/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /reflectionSessions/{sessionId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if resourceOwner();
    }

    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow create: if signedIn();
    }

    match /reflectionStats/{statId} {
      allow read, create: if signedIn();
    }
  }
}
